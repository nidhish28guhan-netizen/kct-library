{
  "name": "clms-backend",
  "version": "1.0.0",
  "private": true,
  "description": "College Library Management System — REST API (Express, JSON persistence)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/db/seed.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest tests/domain --runInBand",
    "test:api": "jest tests/integration --runInBand",
    "test:e2e": "node tests/e2e/selenium-flow.js && node tests/e2e/selenium-circulation.js",
    "test:e2e:reserve": "node tests/e2e/selenium-flow.js",
    "test:e2e:circulation": "node tests/e2e/selenium-circulation.js",
    "metrics": "node tools/analyze.js",
    "coverage": "jest --coverage --runInBand --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": ["/node_modules/", "/tests/", "/src/db/seed.js", "/tools/"]
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bwip-js": "^4.4.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "acorn": "^8.12.1",
    "jest": "^29.7.0",
    "selenium-webdriver": "^4.23.0",
    "supertest": "^7.0.0"
  }
}
